# Copy to .env.local. Validated by src/lib/env/schema.ts.

# Local development with the Firebase emulators (npm run emulators):
# this is the only line you need; everything else has a safe local default.
NEXT_PUBLIC_USE_EMULATORS=true

# ----- Real Firebase project (Vercel / production). Set NEXT_PUBLIC_USE_EMULATORS=false -----
# Public (safe for the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only (never prefix with NEXT_PUBLIC_)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
SESSION_COOKIE_NAME=__session
STUDENT_LOGIN_DOMAIN=students.studysathi.local
